# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL, plain HTTP on port 8106.
DOLI_URL=http://localhost:8106
SITE_ADDRESS=:80
HTTP_PORT=8106
HTTPS_PORT=8406
MAILPIT_PORT=8025

# Development mode: shows errors.
DOLI_PROD=0

# Dev-only credentials.
DB_PASSWORD=dolibarr
DB_ROOT_PASSWORD=root
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=admin12345

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=erp@example.com

# Optional overrides (see overrides/*.yaml), combined with ":".
#COMPOSE_FILE=compose.yaml:overrides/module.yaml
#MODULE_PATH=../billmysales-plugin-dolibarr
#MODULE_NAME=billmysales
