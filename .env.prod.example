# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=dolibarr

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below).
#TRAEFIK_HOST=erp.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of Dolibarr (written to conf.php on every `up`).
DOLI_URL=https://erp.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=erp.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Credentials (REQUIRED, use long random values: openssl rand -base64 24)
# ---------------------------------------------------------------------------
DB_PASSWORD=
DB_ROOT_PASSWORD=
DOLI_ADMIN_PASSWORD=
#DOLI_ADMIN_LOGIN=admin
#DB_NAME=dolibarr
#DB_USER=dolibarr

# ---------------------------------------------------------------------------
# Company (initial settings, applied only on the first install)
# ---------------------------------------------------------------------------
#DOLI_COMPANY_NAME=Dolibarr
#DOLI_LANG=es_CL
#DOLI_COUNTRY=CL
#DOLI_CURRENCY=CLP
#PHP_TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Dolibarr release and its archive's SHA-256 (empty = don't verify). Changing
# it and running `docker compose up -d` upgrades Dolibarr (code + database).
# Back up first.
#DOLI_VERSION=24.0.1
#DOLI_SHA256=cd5cb03c3f927007c7e4c63a02ebdebdcf81efd378603729bbcf6991ffa1b9c4
#PHP_VERSION=8.5
# Image name for the built Dolibarr image.
#DOLI_IMAGE=dolibarr-fpm
#CADDY_VERSION=2.11
#MARIADB_VERSION=12.3
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# Dolibarr / PHP
# ---------------------------------------------------------------------------
# Production mode (1) hides errors. Use 0 only for development.
#DOLI_PROD=1
#PHP_MEMORY_LIMIT=256M
#PHP_MAX_EXECUTION_TIME=300
# Max upload/request size (PHP and Caddy).
#UPLOAD_MAX_SIZE=64M
# PHP-FPM pool. Rough sizing: max_children = RAM for PHP / ~60 MB per worker.
#PHP_FPM_MAX_CHILDREN=10
#PHP_FPM_START_SERVERS=2
#PHP_FPM_MIN_SPARE_SERVERS=1
#PHP_FPM_MAX_SPARE_SERVERS=4
#PHP_FPM_MAX_REQUESTS=500

# ---------------------------------------------------------------------------
# Mail (SMTP). When SMTP_HOST is set, these values replace Dolibarr's email
# settings on every `up`.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS), ssl (implicit TLS), none (or empty).
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Default sender address.
#SMTP_FROM=

# ---------------------------------------------------------------------------
# Scheduled jobs and backups
# ---------------------------------------------------------------------------
#CRON_INTERVAL=300
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#DB_MEMORY_LIMIT=1g
#DOLI_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#CRON_MEMORY_LIMIT=512m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
